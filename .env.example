LITECLAW_MODEL_PROVIDER=openai_compatible
LITECLAW_MODEL=gpt-5-mini
LITECLAW_BASE_URL=https://api.openai.com/v1
LITECLAW_API_KEY=
LITECLAW_DB_PATH=./data/liteclaw.db
LITECLAW_WORKSPACE_ROOT=.
LITECLAW_MAX_AGENT_STEPS=8
LITECLAW_CONTEXT_TOKEN_BUDGET=24000
LITECLAW_RECENT_MESSAGE_TOKENS=8000
LITECLAW_MEMORY_TOP_K=8
LITECLAW_BROWSER_HEADLESS=true
LITECLAW_REQUIRE_APPROVAL=true
LITECLAW_LOG_LEVEL=INFO
LITECLAW_EMBEDDING_MODEL=
LITECLAW_MCP_SERVERS_PATH=mcp_servers.yaml
LITECLAW_ENABLE_PLANNER=false
